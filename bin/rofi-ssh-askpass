#!/bin/sh

# ssh-askpass implementation with rofi.

message="${1:-Enter your OpenSSH passphrase:}"
dpi=$(xrdb -query | sed -nE 's/^Xft\.dpi:\s*//p')
dpi=${dpi:-0}

mesg="$(printf '%s' "$message" \
    | sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e '$s/:[[:space:]]*$//')"

case ${SSH_ASKPASS_PROMPT:-} in
    none)
        exec rofi -dpi $dpi -e "$message"
        ;;
    confirm)
        answer=$(printf 'Yes\nNo\n' \
                     | rofi -dpi $dpi -no-lazy-grab -dmenu -no-custom \
                            -selected-row 1 -p confirm -mesg "$mesg" \
                            -theme-str 'entry { placeholder: ""; } listview { fixed-height: false; }')
        [ "$answer" = Yes ]
        ;;
    *)
        exec rofi -dpi $dpi -no-lazy-grab -dmenu -password \
             -p passphrase -mesg "$mesg" \
             -theme-str 'entry { placeholder: ""; } listview { enabled: false; }' \
             < /dev/null
        ;;
esac
